# Azure Discovery Tool - Git Ignore

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
ENV/
env/

# Bundled Python and packages (large binary distribution)
tool/

# Discovery output (keep sample files, exclude actual generated output)
discovery_output/*.xlsx
discovery_output/*.log
discovery_output/azure_*.html
discovery_output/azure_*.json

# Offline packages (downloaded via download_packages_offline.cmd)
offline_packages/

# Azure CLI installer (optional download)
installers/

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
